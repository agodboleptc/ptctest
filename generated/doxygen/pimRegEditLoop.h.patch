+	 * @param Key Root-hive token: one of [HKCR]/[HKLM]/[HKCU]/[HKU].
+	 * @param Id Subkey path under the root.
+	 * @param ValueName Named value to remove, or empty to remove the whole key.
+	 * @return true on success.
+	 */
 	bool Remove(const btkString &Key, const btkString &Id, const btkString &ValueName);
 
 	//bool IsOKToDelete(const btkString &Key, const btkString &Id);
 public:
+	/**
+	 * Constructs a pimRegEditLoop bound to the given XML content, with
+	 * do_rollback initialized to false.
+	 * @param ScriptXMLContent The product/entitlement XML describing what to install.
+	 */
 	pimRegEditLoop(pimXmlFile *ScriptXMLContent) : pimLoop(ScriptXMLContent)
 	{
 		do_rollback = false;

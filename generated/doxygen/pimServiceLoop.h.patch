+	 * @param start_cmd Command used to start the service.
+	 * @param Converter Resolves property placeholders in start_cmd.
+	 * @return true on success (including already-running).
+	 */
 	bool StartService(const char *name, const char *start_cmd, pimConvert *);
+
+	/**
+	 * Stops a running service.
+	 *

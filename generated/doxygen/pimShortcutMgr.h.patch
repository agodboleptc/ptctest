+	 * supported location types (start_menu/programsmenu/desktop/
+	 * quicklaunch) are currently create="Y". Does not report a Loadpoint
+	 * state -- see class-level doc.
+	 * @param id The shortcut's id attribute value.
+	 * @param Label Receives the shortcut's <NAME> child text.
+	 * @param assoc_package Receives the linked package name, if any.
+	 * @param start_menu Receives the Start Menu create state.
+	 * @param programsmenu Receives the Programs Menu create state.
+	 * @param desktop Receives the Desktop create state.
+	 * @param quicklaunch Receives the Quick Launch create state.
+	 * @return true if the shortcut was found.
+	 */
+	bool GetShortcutInfoByID(const char *id,
 		btkString &Label, btkString &assoc_package,
-		bool &start_menu, bool &programsmenu, 
+		bool &start_menu, bool &programsmenu,
 		bool &desktop, bool &quicklaunch);
 
+	/**
+	 * Scans every <SHORTCUT> node; returns false the instant any node has
+	 * showenvironment="N" (a single opt-out suppresses the prompt for the
+	 * whole document), true only if the whole document is scanned without
+	 * finding one.
+	 * @return Whether the environment-choice prompt should be shown.
+	 */
 	bool ShowEnvironmentChoice();
+
+	/**
+	 * Sets the Start Menu create state for a specific shortcut.
+	 * @param id The shortcut's id attribute value.
+	 * @param install New create state.
+	 * @return true if the shortcut was found and updated.
+	 */
 	bool SetShortcutStartMenuState(const char *id, bool install);
+
+	/**
+	 * Sets the Programs Menu create state for a specific shortcut.
+	 * @param id The shortcut's id attribute value.
+	 * @param install New create state.
+	 * @return true if the shortcut was found and updated.
+	 */
 	bool SetShortcutProgramsMenuState(const char *id, bool install);
+
+	/**
+	 * Sets the Desktop create state for a specific shortcut.

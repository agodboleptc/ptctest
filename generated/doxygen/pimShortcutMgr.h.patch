+/**
+ * Lightweight, non-owning wrapper over a product's <SHORTCUT> XML elements,
+ * providing a query/mutation API independent of pimShortcutLoop/pimShortcuts
+ * (the install-time class family). Always constructed stack-local and
+ * short-lived; never a singleton. Used from both pim_ui dialogs and
+ * pim_core (pimEntitlement.cxx, pimSilent.cxx).
+ *
+ * Covers only 4 of the 5 location types pimShortcutLoop supports (Start
+ * Menu, Programs Menu, Desktop, Quick Launch -- no Loadpoint).
+ *
+ * CONFIRMED: AreChangesPending() can only detect a CHANGED shortcut (one
+ * whose id exists in both compared instances) -- it cannot detect a
+ * shortcut being added or removed entirely between the two, since its loop
+ * only iterates this instance's own id list and skips ids not found in the
+ * other. See docs/classes/pimShortcutMgr.md Risk Analysis for the confirmed
+ * real-world consequence in pimEntitlement.cxx's update/reconfigure logic.
+ *
+ * CONFIRMED: GetShortcutDesktopState() is not a per-id query despite its
+ * name/signature parity with the 4 location setters -- it returns the
+ * create state of whichever shortcut happens to declare a DESKTOP child
+ * first in document order.
+ */
 class pimShortcutMgr
 {
 private:
 	pimXmlFile *xml;
 
+	/**
+	 * @param id The shortcut's id attribute value.
+	 * @return The matching <SHORTCUT> node, or NULL if not found.
+	 */
 	DOMNode *FindShortcutNode(const char *id);
+
+	/**
+	 * Sets create="Y"/"N" on the location child named by Match under the
+	 * shortcut named by id, and marks the document content changed.
+	 * @param id The shortcut's id attribute value.
+	 * @param Match The location child element's tag name.
+	 * @param install New create state.
+	 * @return true if the shortcut and location child were found and updated.
+	 */
 	bool SetShortcutState(const char *id, const XMLCh [], bool install);
+
+	/**
+	 * Finds every shortcut id that has a child element named Match,
+	 * regardless of that child's own create state.
+	 * @param out Receives the matching shortcut ids.
+	 * @param Match The location child element's tag name to look for.
+	 * @return true if at least one match was found.
+	 */
 	bool GetMatchingShortcutIDs(StringXArray& out, const XMLCh Match[]);
+
+	/**
+	 * Reads the create attribute of a specific shortcut's location child.
+	 * @param id The shortcut's id attribute value.
+	 * @param Match The location child element's tag name.
+	 * @param value Receives the create attribute's value.
+	 * @return true if the shortcut and location child were found.
+	 */
 	bool GetShortcutState(const char* id, const XMLCh Match[], btkString& value);
 
 public:
+	/**
+	 * Constructs a pimShortcutMgr wrapping ptr. Does not take ownership --
+	 * the destructor does not delete ptr.
+	 * @param ptr The product XML document to wrap.
+	 */
 	pimShortcutMgr(pimXmlFile *ptr);
 	~pimShortcutMgr();
 
-	bool GetShortcutInfoByID(const char *id, 

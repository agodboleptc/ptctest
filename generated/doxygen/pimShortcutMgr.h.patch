 	bool SetShortcutStartDir(const char *id, const char *value);
+
+	/**
+	 * Reads the start-in directory for a specific shortcut.
+	 * @param id The shortcut's id attribute value.
+	 * @param value Receives the start-in directory.
+	 * @return true if the shortcut was found.
+	 */
 	bool GetShortcutStartDir(const char *id, btkString &value);
 
+	/**
+	 * @param out Receives every <SHORTCUT> node's id attribute, in document order.
+	 * @return true if at least one shortcut was found.
+	 */
 	bool GetAllShortcutIDs(StringXArray &);
 
+	/**
+	 * Sets allusers="Y"/"N" on every <SHORTCUT> node that already has an
+	 * allusers attribute (a document-wide setting mirrored across every
+	 * node, not a per-shortcut one). Does NOT mark the document content
+	 * changed (see SetShortcutProgramMenu()'s doc).
+	 * @param all_users New environment choice.
+	 * @return true if at least one node was updated.
+	 */
 	bool SetEnvironmentChoice(bool all_users);
+
+	/**
+	 * Reads allusers from the first <SHORTCUT> node in document order that
+	 * has one, then stops.
+	 * @param all_users Receives the environment choice.
+	 * @return true if any node had an allusers attribute.
+	 */
 	bool GetEnvironmentChoice(bool &all_users);
 
+	/**
+	 * Compares this instance's shortcuts against cmp_to's. CONFIRMED: only
+	 * detects a changed shortcut (one whose id exists in both); cannot
+	 * detect a shortcut added or removed entirely between the two -- see
+	 * class-level doc and docs/classes/pimShortcutMgr.md Risk Analysis.
+	 * @param cmp_to The instance to compare against.
+	 * @return true if any shared-id shortcut's label/package/location states differ.
+	 */
 	bool AreChangesPending(pimShortcutMgr &cmp_to);
 
+	/**
+	 * NOT a per-id query despite the signature parity with
+	 * SetShortcutDesktopState() -- returns the create state of whichever
+	 * shortcut happens to declare a DESKTOP child first in document order.
+	 * See class-level doc.
+	 * @param value Receives the first matching shortcut's Desktop create state.
+	 * @return true if any shortcut with a DESKTOP child was found.
+	 */
 	bool GetShortcutDesktopState(btkString& value);
 
 
